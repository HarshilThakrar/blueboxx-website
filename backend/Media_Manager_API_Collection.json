{
	"info": {
		"_postman_id": "media-manager-1234",
		"name": "Blueboxx Media Manager API",
		"description": "Complete production-ready APIs for the Enterprise Digital Asset Management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Folders",
			"item": [
				{
					"name": "Create Folder",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Course Assets\",\n    \"parent_id\": null\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/admin/media/folders",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "media", "folders"]
						}
					}
				},
				{
					"name": "Delete (Trash) Folder",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/media/folders/1",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "media", "folders", "1"]
						}
					}
				}
			]
		},
		{
			"name": "2. Files",
			"item": [
				{
					"name": "List Files & Folders",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/media/files?folder_id=1&type=image",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "media", "files"],
							"query": [
								{ "key": "folder_id", "value": "1" },
								{ "key": "type", "value": "image" }
							]
						}
					}
				},
				{
					"name": "Upload Standard File",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "file", "type": "file", "src": [] },
								{ "key": "folder_id", "value": "1", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/api/admin/media/files/upload",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "media", "files", "upload"]
						}
					}
				}
			]
		},
		{
			"name": "3. Analytics & Trash",
			"item": [
				{
					"name": "Statistics",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/media/statistics",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "media", "statistics"]
						}
					}
				},
				{
					"name": "View Trash",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/media/trash",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "media", "trash"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000" },
		{ "key": "auth_token", "value": "YOUR_TOKEN_HERE" }
	]
}
